  "fieldExplanations": {
    "from": "Driver's WhatsApp phone number (with country code)",
    "to": "Your WhatsApp Business number (Infobip sender)",
    "messageId": "Order ID or message identifier",
    "receivedAt": "Timestamp when message was received (ISO format)",
    "message.type": "Message type - usually 'text' for text messages",
    "message.text": "Actual message content from driver", 
    "context.from": "Same as 'from' field",
    "context.id": "Unique message ID from WhatsApp",
    "context.groupId": "Group conversation ID (if applicable)"
  },
  
  "curlExamples": [
    {
      "name": "Driver says Yes",
      "command": "curl -X POST 'http://localhost:8080/whatsapp/callback' -H 'Content-Type: application/json' -d '{\"results\":[{\"from\":\"971526328601\",\"to\":\"919601112550\",\"messageId\":\"ORD987654321\",\"receivedAt\":\"2025-06-30T09:30:00\",\"message\":{\"type\":\"text\",\"text\":\"Yes I am on time\"},\"context\":{\"from\":\"971526328601\",\"id\":\"msg123456\",\"groupId\":\"group123\"}}]}'"
    },
    {
      "name": "Driver says No", 
      "command": "curl -X POST 'http://localhost:8080/whatsapp/callback' -H 'Content-Type: application/json' -d '{\"results\":[{\"from\":\"971526328601\",\"to\":\"919601112550\",\"messageId\":\"ORD987654321\",\"receivedAt\":\"2025-06-30T09:35:00\",\"message\":{\"type\":\"text\",\"text\":\"I am late\"},\"context\":{\"from\":\"971526328601\",\"id\":\"msg123457\",\"groupId\":\"group123\"}}]}'"
    },
    {
      "name": "Driver provides ETA",
      "command": "curl -X POST 'http://localhost:8080/whatsapp/callback' -H 'Content-Type: application/json' -d '{\"results\":[{\"from\":\"971526328601\",\"to\":\"919601112550\",\"messageId\":\"ORD987654321\",\"receivedAt\":\"2025-06-30T09:45:00\",\"message\":{\"type\":\"text\",\"text\":\"10:30 AM\"},\"context\":{\"from\":\"971526328601\",\"id\":\"msg123459\",\"groupId\":\"group123\"}}]}'"
    }
  ]
} 